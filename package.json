{
    "name": "agri-mech-connect-root",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "start": "npm --prefix backend start",
        "dev": "npm --prefix backend run dev",
        "test": "npm --prefix backend test",
        "health": "node -e \"fetch('http://127.0.0.1:5000/api/health').then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2))).catch(e=>console.error('Backend offline:',e.message))\"",
        "migrate:cloudinary": "npm --prefix backend run migrate:cloudinary",
        "migrate:cloudinary-images": "npm --prefix backend run migrate:cloudinary-images"
    },
    "dependencies": {
        "@supabase/server": "^1.9.2",
        "postgres": "^3.4.9"
    }
}
