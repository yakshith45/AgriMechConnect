PORT=5000
HOST=0.0.0.0

# Supabase Dashboard -> Connect: direct URI (IPv6 or IPv4 add-on) or Session pooler URI (IPv4 networks).
# Include the PostgreSQL database password in the URI; no Supabase API key is used by this backend.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Download the Supabase CA certificate to backend/ and set its filename here.
DATABASE_SSL_CA_PATH=ssl/prod-ca-2021.crt

# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Cloudinary Console -> Product environment credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=agrimech/machinery

FRONTEND_ORIGINS=http://127.0.0.1:5501,http://localhost:5501,http://127.0.0.1:5500,http://localhost:5500
